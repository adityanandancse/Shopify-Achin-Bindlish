<div class="Seen">

  <div class="Container">
    <header class="Seen__Header">
      <span class="Seen__Eyebrow">Seen</span>
      <h1 class="Seen__Title u-h1">{{ page.title }}</h1>
      {%- if page.content != blank -%}
        <div class="Seen__Intro Rte">{{ page.content }}</div>
      {%- endif -%}
    </header>
  </div>

  {%- section 'celebrity-carousel' -%}

  <div class="Container">
    <div class="Seen__Grid">
      {%- for i in (1..12) -%}
        {%- assign img_key = 'seen_image_' | append: i -%}
        {%- assign name_key = 'seen_name_' | append: i -%}
        {%- assign piece_key = 'seen_piece_' | append: i -%}
        {%- assign link_key = 'seen_link_' | append: i -%}

        {%- assign img = settings[img_key] -%}
        {%- if img != blank -%}
          <figure class="Seen__Item">
            {%- if settings[link_key] != blank -%}<a href="{{ settings[link_key] }}">{%- endif -%}
              <img src="{{ img | img_url: '800x' }}"
                   width="800"
                   height="{{ 800 | divided_by: img.aspect_ratio | round }}"
                   loading="lazy"
                   alt="{{ settings[name_key] | escape }}">
            {%- if settings[link_key] != blank -%}</a>{%- endif -%}
            <figcaption class="Seen__Caption">
              <span class="Seen__Name">{{ settings[name_key] }}</span>
              {%- if settings[piece_key] != blank -%}
                <span class="Seen__Piece">{{ settings[piece_key] }}</span>
              {%- endif -%}
            </figcaption>
          </figure>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

</div>

<style>
  .Seen__Header {
    max-width: 720px;
    margin: 64px auto 40px;
    text-align: center;
  }

  .Seen__Eyebrow {
    display: block;
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #7A6A5C;
    margin-bottom: 16px;
  }

  .Seen__Title { margin: 0 0 16px; }

  .Seen__Grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin: 72px 0 96px;
  }

  .Seen__Item { margin: 0; }

  .Seen__Item img {
    display: block;
    width: 100%;
    height: auto;
  }

  .Seen__Caption {
    margin-top: 12px;
    text-align: left;
  }

  .Seen__Name {
    display: block;
    font-size: 14px;
    color: #3A0A0A;
  }

  .Seen__Piece {
    display: block;
    font-size: 12px;
    color: #7A6A5C;
    margin-top: 2px;
  }

  @media (max-width: 900px) {
    .Seen__Grid { grid-template-columns: repeat(2, 1fr); gap: 20px; }
  }

  @media (max-width: 640px) {
    .Seen__Header { margin: 40px auto 24px; }
    .Seen__Grid { margin: 40px 0 64px; }
  }
</style>