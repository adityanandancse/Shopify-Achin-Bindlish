ors":false,"show_only_once":false,"title":"Popup","content":"<p>You can use this popup to display some useful information to your customers.<\/p>","show_newsletter":true,"apparition_delay":5}},"1536065219503":{"type":"image-with-text-block","settings":{"image":"shopify:\/\/shop_images\/bg_871d60f9-f8a8-4b32-86da-ab44d2ddc6de.png","background":"#241A14","text_color":"#FFF6E4","block_size":"normal","title":"DEFENCE COLONY","content":"<p><br\/>Third floor, north light, and a room where every motif is drawn before anything is cut. Fittings are by appointment.<br\/><br\/><\/p>","button_label":"BOOK A FITTING","button_link":"shopify:\/\/collections\/jewelry","show_parallax":true}},"1536065842202":{"type":"testimonials","blocks":{"1536065842202-2":{"type":"testimonial","settings":{"quote":"<p>Every motif is drawn at full size before a single stitch is made.<\/p>"}},"1536065842202-1":{"type":"testimonial","settings":{"quote":"<p>I always want to give a touch to my wrist with luxury watches, l found the perfect and affordable watch on this web shop.<\/p>"}},"1536065842202-0":{"type":"testimonial","settings":{"quote":"<p>A standard size is an average of people who are not you.<\/p>"}},"1536067220146":{"type":"testimonial","settings":{"logo":"shopify:\/\/shop_images\/ACHIN_BINDLISH_150_x_150_px__png.png","quote":"<p>A panel can hold two thousand hours before it becomes a sleeve. That is why a piece takes the time it takes.<\/p>"}}},"block_order":["1536065842202-2","1536065842202-1","1536065842202-0","1536067220146"],"settings":{"autoplay":true,"cycle_speed":5,"background":"#241A14","text_color":"#FFF6E4"}},"1536065970902":{"type":"featured-collections","blocks":{"1536066003542":{"type":"collection","settings":{"collection":"saree","title":"","grid_items_count":16,"button_text":"View all products"}},"1536065970902-0":{"type":"collection","settings":{"collection":"tuxedo","title":"","grid_items_count":8,"button_text":"View all products"}}},"block_order":["1536066003542","1536065970902-0"],"disabled":true,"settings":{"title":"Staff pick of the week!","layout_mode":"carousel","show_product_info":true,"show_color_swatch":false,"grid_mobile_items_per_row":"2","grid_desktop_items_per_row":4}},"1536067011368":{"type":"newsletter","settings":{"section_size":"small","image":"shopify:\/\/shop_images\/bg_871d60f9-f8a8-4b32-86da-ab44d2ddc6de.png","text_color":"#ffffff","button_color":"#000000","subheading":"Keep updated","title":"Newsletter","content":"<p>Subscribe to receive updates, access to exclusive deals, and more.<\/p>"}},"text_with_image_8rXxaB":{"type":"text-with-image","name":"Rich text with image","settings":{"subheading":"Design","title":"It begins on paper","image":"shopify:\/\/shop_images\/sketch-beside-the-finished-panel.png","image_position":"right","content":"<p>A garment here starts as a subject, not a silhouette. A deer. A bird. A season of light.<\/p><p>The motif is drawn first, at full size, and only then does anyone ask what it will be worn to.<\/p><p>Nothing is printed. Nothing is bought in. Every mark on every piece was put there by a hand holding a needle.<\/p>","link_text":"See the chapter","link_url":"shopify:\/\/pages\/about-achin-bindlish-couture-label"}},"text_with_image_iUMwYb":{"type":"text-with-image","name":"Rich text with image","settings":{"subheading":"Work","title":"Hours at the frame","image":"shopify:\/\/shop_images\/karigars-hands.png","image_position":"left","content":"<p>Zardozi is counted in hours, not in days. A panel can hold two thousand of them before it becomes a sleeve.<\/p><p>Our karigars work in Delhi, on frames, in daylight. Silver and white thread laid one stitch at a time, raised off the cloth so the animal sits above it rather than on it.<\/p><p>It cannot be hurried, and we do not try.<\/p>","link_text":"The atelier","link_url":"shopify:\/\/pages\/about-achin-bindlish-couture-label"}},"text_with_image_j3nKf6":{"type":"text-with-image","name":"Rich text with image","settings":{"subheading":"Fit","title":"Forty measurements","image":"shopify:\/\/shop_images\/hands-at-the-tape-fitting-room.png","image_position":"right","content":"<p>A standard size is an average of people who are not you.<\/p><p>Any piece in the house can be cut to your own measurements, at no additional cost. Forty of them, taken at the atelier in Defence Colony - or entered yourself, and confirmed by us before anything is cut.<\/p><p>Nothing is shortened to fit a date. If we cannot finish it properly in the time you have, we will tell you.<\/p>","link_text":"How it works","link_url":"shopify:\/\/pages\/about-achin-bindlish-couture-label"}},"celebrity_carousel_heNtk9":{"type":"celebrity-carousel","blocks":{"image_peyMkz":{"type":"image","settings":{"carousel_image":"shopify:\/\/shop_images\/Madhuri.png","image_alt":"Madhuri Dixit","carousel_link":""}},"image_LH7xwe":{"type":"image","settings":{"carousel_image":"shopify:\/\/shop_images\/Genelia.png","image_alt":"Genelia D'Souza","carousel_link":"shopify:\/\/products\/mythic-grove-blazer-dress"}},"image_H8BiNU":{"type":"image","settings":{"carousel_image":"shopify:\/\/shop_images\/Shreya.png","image_alt":"","carousel_link":""}},"image_Hpa4Vz":{"type":"image","settings":{"carousel_image":"shopify:\/\/shop_images\/Rajkumar_Rao.png","image_alt":"","carousel_link":""}},"image_TLzagL":{"type":"image","settings":{"carousel_image":"shopify:\/\/shop_images\/Randeep.png","image_alt":"","carousel_link":""}},"image_fzrbyF":{"type":"image","settings":{"carousel_image":"shopify:\/\/shop_images\/Aditya_Seal.png","image_alt":"","carousel_link":""}}},"block_order":["image_peyMkz","image_LH7xwe","image_H8BiNU","image_Hpa4Vz","image_TLzagL","image_fzrbyF"],"name":"Celebrity carousel","settings":{"title":"celebrity closet","title_color":"#FFF6E4","bg_color":"#241A14","padding_vertical":10,"border_width":0,"border_color":"#7a6a5c","scroll_speed":60,"image_height":300,"image_height_mobile":220,"image_spacing":25,"direction":"left"}},"celebrity_carousel_d6GxJM":{"t